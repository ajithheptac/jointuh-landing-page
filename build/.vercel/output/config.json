{
  "version": 3,
  "routes": [
    {
      "src": "^(?:\\/((?:[^\\/]+?)(?:\\/(?:[^\\/]+?))*))\\/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308,
      "continue": true
    },
    {
      "src": "/404/?",
      "status": 404,
      "continue": true,
      "missing": [
        {
          "type": "header",
          "key": "x-prerender-revalidate"
        }
      ]
    },
    {
      "src": "/500/?",
      "status": 500,
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/_next/data/(.*)",
      "dest": "/_next/data/$1",
      "check": true
    },
    {
      "handle": "resource"
    },
    {
      "src": "/.*",
      "status": 404
    },
    {
      "handle": "miss"
    },
    {
      "src": "/_next/static/.+",
      "status": 404,
      "check": true,
      "dest": "/_next/static/not-found.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "handle": "hit"
    },
    {
      "src": "/_next/static/(?:[^/]+/pages|pages|chunks|immutable|runtime|css|image|media|lhhRM7UOMdL_9IzONS82g)/.+",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true,
      "important": true
    },
    {
      "src": "/(?:index)?(?:/)?$",
      "headers": {
        "x-matched-path": "/"
      },
      "continue": true,
      "important": true
    },
    {
      "src": "/((?!index$).*?)(?:/)?$",
      "headers": {
        "x-matched-path": "/$1"
      },
      "continue": true,
      "important": true
    },
    {
      "handle": "error"
    },
    {
      "src": "/.*",
      "dest": "/_not-found",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/_error",
      "status": 500
    }
  ],
  "images": {
    "localPatterns": [
      {
        "pathname": "^(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$))(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$)).)*?)\\/?)$",
        "search": ""
      }
    ],
    "remotePatterns": [],
    "sizes": [
      32,
      48,
      64,
      96,
      128,
      256,
      384,
      640,
      750,
      828,
      1080,
      1200,
      1920,
      2048,
      3840
    ],
    "domains": [],
    "qualities": [
      75
    ],
    "minimumCacheTTL": 14400,
    "formats": [
      "image/webp"
    ],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "attachment"
  },
  "overrides": {
    "404.html": {
      "contentType": "text/html; charset=utf-8",
      "path": "404"
    },
    "_not-found.html": {
      "contentType": "text/html; charset=utf-8",
      "path": "_not-found"
    },
    "index.html": {
      "contentType": "text/html; charset=utf-8",
      "path": "index"
    },
    "privacy-portal.html": {
      "contentType": "text/html; charset=utf-8",
      "path": "privacy-portal"
    },
    "terms.html": {
      "contentType": "text/html; charset=utf-8",
      "path": "terms"
    }
  },
  "framework": {
    "slug": "nextjs",
    "version": "16.3.1"
  },
  "crons": []
}
